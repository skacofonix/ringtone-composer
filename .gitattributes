# Normalize line endings to LF in the repository
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.wav binary
*.mp3 binary
*.ogg binary
*.m4a binary
*.m4r binary
